{
  "name": "dom-remote",
  "version": "1.0.0",
  "description": "DOM Remote - Premium Dark Remote Access App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "capacitor:add:android": "cap add android",
    "capacitor:build:android": "vite build && cap copy android && cap open android",
    "capacitor:build:apk": "vite build && cap copy android && cd android && ./gradlew assembleDebug",
    "server:dev": "cd server && npm run dev",
    "server:start": "cd server && npm start",
    "server:install": "cd server && npm install",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "postinstall": "cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "jsdom": "^30.1.3",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.domremote.app",
    "productName": "DOM Remote",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doommsky/dom-remote.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/doommsky/dom-remote/issues"
  },
  "homepage": "https://github.com/doommsky/dom-remote#readme"
}
